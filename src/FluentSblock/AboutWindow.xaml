<Window x:Class="FluentSblock.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="250" Width="430" MinWidth="380" MinHeight="230"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}">
  <StackPanel Margin="16">
    <StackPanel Orientation="Horizontal">
      <Image Width="64" Height="64" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Source>
          <BitmapImage UriSource="Assets/about-icon.png" DecodePixelWidth="64"/>
        </Image.Source>
      </Image>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="AboutTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="AboutVersion" Opacity="0.7" Margin="0,4,0,0"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="AboutBody" Margin="0,12,0,0" TextWrapping="Wrap"/>
    <Button Content="OK" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" Click="OnOkClick"/>
  </StackPanel>
</Window>
