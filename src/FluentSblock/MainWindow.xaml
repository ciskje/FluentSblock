<Window x:Class="FluentSblock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluentSblock" Height="620" Width="980"
        MinWidth="800" MinHeight="500" AllowDrop="True"
        Drop="OnFileDrop" DragOver="OnDragOver"
        FontFamily="{StaticResource AppFontFamily}">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem x:Name="MiFile" Header="_File">
        <MenuItem x:Name="MiRefresh" Header="_Refresh" InputGestureText="F5" Click="OnRefreshClick">
          <MenuItem.Icon><ContentControl Content="{StaticResource IconRefresh}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="MiEject" Header="_Eject" Click="OnEjectClick" IsEnabled="False">
          <MenuItem.Icon><ContentControl Content="{StaticResource IconEject}"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="MiExportCsv" Header="Export CSV" Click="OnExportCsvClick"/>
        <MenuItem x:Name="MiExportTsv" Header="Export TSV" Click="OnExportTsvClick"/>
        <Separator/>
        <MenuItem x:Name="MiExit" Header="E_xit" Click="OnExitClick">
          <MenuItem.Icon><ContentControl Content="{StaticResource IconExit}"/></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem x:Name="MiView" Header="_View">
        <MenuItem x:Name="MiTheme" Header="_Theme">
          <MenuItem.Icon><ContentControl Content="{StaticResource IconTheme}"/></MenuItem.Icon>
          <MenuItem x:Name="MiThemeSystem" Header="System" IsCheckable="True" IsChecked="True" Click="OnThemeClick"/>
          <MenuItem x:Name="MiThemeLight" Header="Light" IsCheckable="True" IsEnabled="False" Click="OnThemeClick"/>
          <MenuItem x:Name="MiThemeDark" Header="Dark" IsCheckable="True" IsEnabled="False" Click="OnThemeClick"/>
        </MenuItem>
        <MenuItem x:Name="MiLanguage" Header="_Language">
          <MenuItem.Icon><ContentControl Content="{StaticResource IconLanguage}"/></MenuItem.Icon>
          <MenuItem Header="English" Tag="en" Click="OnLanguageClick"/>
          <MenuItem Header="Français" Tag="fr" Click="OnLanguageClick"/>
          <MenuItem Header="Italiano" Tag="it" Click="OnLanguageClick"/>
          <MenuItem Header="Deutsch" Tag="de" Click="OnLanguageClick"/>
          <MenuItem Header="Español" Tag="es" Click="OnLanguageClick"/>
        </MenuItem>
        <Separator/>
        <MenuItem x:Name="MiAutostart" Header="Start with Windows" IsCheckable="True" Click="OnAutostartClick"/>
      </MenuItem>
      <MenuItem x:Name="MiHelp" Header="_Help">
        <MenuItem x:Name="MiShowLog" Header="Show log" Click="OnShowLogClick"/>
        <MenuItem x:Name="MiAbout" Header="_About" Click="OnAboutClick">
          <MenuItem.Icon><ContentControl Content="{StaticResource IconAbout}"/></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource AccentBrush}"/>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,6,0"
                     Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"/>
          </StackPanel>
        </StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="AdminText" Text=""/></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="VersionText" Text=""/></StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="150"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
        <ComboBox x:Name="DriveBox" Width="320" Margin="0,0,8,0"
                  SelectionChanged="OnDriveSelectionChanged"/>
        <Button x:Name="RefreshBtn" MinWidth="110" Margin="0,0,8,0" Click="OnRefreshClick">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentControl Content="{StaticResource IconRefresh}" Margin="0,0,6,0">
              <ContentControl.RenderTransform>
                <RotateTransform x:Name="RefreshSpin" Angle="0" CenterX="8" CenterY="8"/>
              </ContentControl.RenderTransform>
            </ContentControl>
            <AccessText x:Name="RefreshBtnText" Text="_Refresh" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="EjectBtn" MinWidth="110" IsEnabled="False" Click="OnEjectClick">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentControl Content="{StaticResource IconEject}" Margin="0,0,6,0"/>
            <AccessText x:Name="EjectBtnText" Text="_Eject" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" Foreground="{StaticResource AccentBrush}"/>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" x:Name="DriveGroup" Header="Removable drives" Margin="0,0,8,0">
          <ListBox x:Name="DriveList" SelectionChanged="OnDriveSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <ContentControl Content="{StaticResource IconFolder}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>
        <GroupBox Grid.Column="1" x:Name="HoldersGroup" Header="Programs with open files">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
              <ContentControl Content="{StaticResource IconSearch}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBox x:Name="FilterBox" Width="220" TextChanged="OnFilterChanged"/>
            </StackPanel>
          <DataGrid x:Name="HoldersGrid">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="MiCopyPath" Header="Copy path" Click="OnCopyPathClick"/>
                <MenuItem x:Name="MiOpenLocation" Header="Open file location" Click="OnOpenLocationClick"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" x:Name="ColProcess"/>
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" x:Name="ColPid"/>
              <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120" x:Name="ColUser"/>
              <DataGridTextColumn Header="Handle" Binding="{Binding HandleHex}" Width="100" x:Name="ColHandle"/>
              <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="90" x:Name="ColAccess"/>
              <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" x:Name="ColFile"/>
            </DataGrid.Columns>
          </DataGrid>
          </DockPanel>
        </GroupBox>
      </Grid>

      <GridSplitter Grid.Row="2" Height="5" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent"/>

      <GroupBox Grid.Row="3" x:Name="CheckFileGroup" Header="Check a file">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="FilePathBox" Width="480" Margin="0,0,8,0" GotFocus="OnFilePathGotFocus" LostFocus="OnFilePathLostFocus"/>
            <Button x:Name="BrowseBtn" MinWidth="100" Margin="0,0,8,0" Click="OnBrowseClick">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{StaticResource IconFolder}" Margin="0,0,6,0"/>
                <AccessText x:Name="BrowseBtnText" Text="Browse…" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="CheckFileBtn" MinWidth="170" Click="OnCheckFileClick">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="CheckFileIcon" Content="{StaticResource IconSearch}" Margin="0,0,6,0"/>
                <ContentControl x:Name="CheckFileRing" Margin="0,0,6,0" Visibility="Collapsed">
                  <ContentControl.RenderTransform>
                    <RotateTransform x:Name="CheckFileSpin" Angle="0" CenterX="8" CenterY="8"/>
                  </ContentControl.RenderTransform>
                  <Viewbox Width="16" Height="16">
                    <Grid Width="24" Height="24">
                      <Path Data="M12,3 A9,9 0 1,1 3,12" Fill="Transparent"
                            Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                  </Viewbox>
                </ContentControl>
                <AccessText x:Name="CheckFileBtnText" Text="Who is locking it?" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="DropHint" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                     FontStyle="Italic" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
          <DataGrid x:Name="FileHoldersGrid" Grid.Row="2" Margin="0,8,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150"/>
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
              <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
