<Window x:Class="FluentSblock.EjectErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cannot eject" Width="460" SizeToContent="Height" MinHeight="210"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}">
  <StackPanel Margin="16">
    <StackPanel Orientation="Horizontal">
      <ContentControl Content="{StaticResource IconWarning}" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="DlgTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="DlgCause" Margin="0,12,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="DlgRemedy" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85"/>
    <Button Content="OK" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" Click="OnOkClick"/>
  </StackPanel>
</Window>
